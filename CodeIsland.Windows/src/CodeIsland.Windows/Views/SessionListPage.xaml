<Page
    x:Class="CodeIsland.Windows.Views.SessionListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CodeIsland.Windows.Views.Controls"
    xmlns:models="using:CodeIsland.Windows.Models"
    xmlns:local="using:CodeIsland.Windows"
    Background="Transparent">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Sessions"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Command="{x:Bind RefreshSessionsCommand}"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>
        </Grid>

        <!-- Empty State -->
        <StackPanel Grid.Row="1"
                    x:Name="EmptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                    Spacing="8">
            <FontIcon Glyph="&#xE703;" FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No Active Sessions"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Start an AI coding tool to begin monitoring."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- Session List -->
        <ListView Grid.Row="1"
                  x:Name="SessionListView"
                  ItemsSource="{x:Bind Sessions}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnSessionItemClick"
                  Visibility="{x:Bind IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SessionState">
                    <controls:SessionCard Session="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Margin="0,8,0,0" Padding="4">
            <TextBlock x:Name="StatusText"
                       Text="{x:Bind StatusText, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
