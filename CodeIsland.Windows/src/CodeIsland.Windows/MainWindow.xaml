<Window
    x:Class="CodeIsland.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodeIsland.Windows"
    xmlns:views="using:CodeIsland.Windows.Views"
    Title="Code Island"
    Width="480" Height="720"
    MinWidth="360" MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    SystemBackdrop="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Padding="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="&#xE737;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Code Island"
                           FontWeight="SemiBold"
                           FontSize="14" />
                <TextBlock Text="AI Session Monitor"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="11" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Frame Grid.Row="1" x:Name="ContentFrame">
            <Frame.Content>
                <views:SessionListPage />
            </Frame.Content>
        </Frame>
    </Grid>
</Window>
